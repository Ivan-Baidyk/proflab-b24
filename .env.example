# Публичный URL виджета — он же redirect_uri и handler в Bitrix24
B24_REDIRECT_URI=https://your-domain.example.com/

# Домен портала Bitrix24 (без https:// и без завершающего /)
B24_DOMAIN=b24-xxxxxxxx.bitrix24.ru

# Креды локального серверного приложения (Bitrix24 → Разработчикам → Локальное приложение)
B24_CLIENT_ID=local.xxxxxxxxxxxxxxxx.xxxxxxxx
B24_CLIENT_SECRET=

# Вебхуки n8n (все три процесса выполняются в n8n)
WEBHOOK_SEARCH_URL=https://your-n8n.example.com/webhook/search-id
WEBHOOK_LOAD_URL=https://your-n8n.example.com/webhook/load-id
WEBHOOK_CREATE_URL=https://your-n8n.example.com/webhook/create-id
